# Every variable the app actually reads, grouped by what stops working without
# it. Anything not listed here is not read by app/, lib/, scripts/ or proxy.ts.
#
# Copy to .env.local and fill in. The "required" block is the minimum for a
# working local instance; without the cron and demo blocks a deployment builds
# and serves, but no data ever refreshes and the demo login fails.


# ─── Required ────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose it to the browser or a client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ─── Scheduled jobs (required in deployment) ─────────────────────────────────

# Shared secret for every /api/cron/* route. Without it those routes answer 503
# and no price, dividend, news, macro or health data is ever refreshed.
#   openssl rand -hex 32
CRON_SECRET=
# Set to "true" once every scheduler sends the secret as an Authorization header
# to stop accepting it as a ?key= query parameter, which leaks into access logs.
CRON_REJECT_QUERY_KEY=false


# ─── Public read-only demo ───────────────────────────────────────────────────

# The shared account behind "Try the read-only demo" on the login page. The
# account is created and seeded on first use. Without these the demo button
# fails and /demo redirects back to the login page.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=


# ─── Research Copilot ────────────────────────────────────────────────────────

# Claude powers the default Copilot models (Haiku / Sonnet / Opus) and the
# news Analyst Brief. Without it the Copilot falls back to DeepSeek only.
CLAUDE_API_KEY=your-anthropic-api-key

# DeepSeek. Any of these spellings is accepted, checked in this order:
# TASKS_API_KEY, DEEP_SEEK_API_KEY, DEEPSEEK_API_KEY.
TASKS_API_KEY=
TASKS_BASE_URL=https://api.deepseek.com/v1
TASKS_MODEL=
DEEPSEEK_API_KEY=

# Optional OpenRouter key for the background task/report models.
OPENROUTER_API_KEY=

# Wall-clock budget for a single Copilot answer, in milliseconds. Defaults to
# the route's maxDuration minus 25s. Lower it if your host caps duration below
# 180s, or the run is killed mid-answer rather than degrading.
CHAT_DEADLINE_MS=


# ─── Filing extraction (vision / OCR) ────────────────────────────────────────

# Reads scanned PSX filings that hold no extractable text layer.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_PDF_ENGINE=
VISION_TIMEOUT_MS=
FILINGS_OCR_MODEL=


# ─── Kill switches ───────────────────────────────────────────────────────────

# Cost containment. Set any to "true" to stop that class of paid call without a
# redeploy of application code. AI_DISABLED covers scheduled AI generation;
# CHAT_DISABLED covers the interactive Copilot; they are deliberately separate
# so a runaway cron does not take the Copilot down with it.
AI_DISABLED=false
CHAT_DISABLED=false
TASKS_DISABLED=false
VISION_DISABLED=false
FILINGS_OCR_DISABLED=false


# ─── News providers ──────────────────────────────────────────────────────────

# Market lane: free macro/policy/sector news from Pakistani business wires
# (Business Recorder, Dawn, Tribune) plus Google News RSS. No key needed. This
# is what surfaces budget/policy/commodity/index news, not just company filings.
NEWS_ENABLE_MARKET=true

# Tavily: optional web/news discovery for per-holding deep search. Also backs
# the Copilot's web context on models without a native search tool.
TAVILY_API_KEY=your-tavily-api-key
NEWS_ENABLE_TAVILY=true

# GDELT: free secondary source. It asks clients to stay near 1 request / 5s.
NEWS_ENABLE_GDELT=true
GDELT_REQUEST_DELAY_MS=5500

# Official PSX company announcements. High-signal: results, dividends, board
# meetings, material information.
NEWS_ENABLE_PSX_ANNOUNCEMENTS=true


# ─── Market data ─────────────────────────────────────────────────────────────

# Options: psx, twelve-data, manual
MARKET_DATA_PROVIDER=psx
MARKET_DATA_API_KEY=

# Twelve Data also powers the capital-allocation forecaster's non-PSX asset
# history (gold XAU/USD, BTC/USD, USD/PKR) and the market cron's ?task=macro
# refresh. Accepted spellings: TWELVE_DATA_API_KEY, MARKET_DATA_API_KEY,
# TWELVE_DATA_API.
TWELVE_DATA_API_KEY=
TWELVE_DATA_API=

# Experimental secondary PSX quote adapter, off by default.
PSX_TERMINAL_ENABLED=false
PSX_TERMINAL_BASE_URL=

# The PKR T-bill / policy-rate path is an explicit admin-editable step series in
# lib/market-data/macro-assets.ts (TBILL_YIELD_STEPS), not a live feed. Edit it
# there when SBP changes the policy rate.

# Foreign / local flows (FIPI / LIPI). Default auto-fetches SCSTrade's public
# tables, which attribute the source data to NCCPL. Set =off for manual entry
# only, or =custom with NCCPL_FLOWS_URL for your own JSON endpoint.
FOREIGN_FLOWS_PROVIDER=scstrade
NCCPL_FLOWS_URL=


# ─── Email ingest ────────────────────────────────────────────────────────────

# AKD trade confirmations via the Gmail Apps Script bridge
# (scripts/apps-script/akd-gmail-ingest.gs -> POST /api/ingest/email).
# EMAIL_INGEST_USER_ID is the auth.users uuid the confirmations belong to.
#   openssl rand -hex 32
EMAIL_INGEST_SECRET=
EMAIL_INGEST_USER_ID=


# ─── Local development only ──────────────────────────────────────────────────

# Path to a broker account-statement PDF used as a ledger fallback when the
# database holds no imported statement. Point it at a file outside the repo:
# these documents are real personal financial records and must not be committed.
AKD_LEDGER_PDF_PATH=

# Overrides for the eval harnesses (npm run eval:chat / eval:chat:live).
EVAL_USER_ID=
EVAL_MODEL=

# --- SBP EasyData (Pakistan macro) ------------------------------------------
# State Bank of Pakistan's open data API: the policy/T-bill rate and national
# CPI. Free key from an EasyData account at easydata.sbp.org.pk, limits are
# 2,000 requests/day and 250/hour.
#
# The key EXPIRES EVERY 90 DAYS. When it lapses the macro jobs fall back to the
# hardcoded policy-step table, which stops at its last known step rather than
# pretending to be current, so a stale-looking T-bill line is the symptom.
#
# Series keys are configured rather than hardcoded because "the short rate" is
# a choice between the policy rate, the 3-month T-bill cut-off and KIBOR. Find
# the key for the series you want in the EasyData catalogue.
SBP_EASYDATA_API_KEY=
SBP_TBILL_SERIES=
SBP_CPI_SERIES=

# Beta operations
# Webhook that receives the daily job-health message (Pumble, Slack, or any
# endpoint accepting {"text": "..."}). Without it the report is only on
# /admin/jobs.
OWNER_ALERT_WEBHOOK_URL=
# Public origin used in invite and password-reset links. Must match the Site
# URL and an allowed redirect (…/auth/callback) in Supabase Auth settings.
NEXT_PUBLIC_SITE_URL=
