{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // No DOM lib and no ambient @types: shared code must not assume a browser,
    // Node, or Jest global. If something here needs one, it does not belong here.
    "types": []
  },
  "include": ["src/**/*.ts"]
}
