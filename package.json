{
  "name": "psx-portfolio-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "npm run lint && npm run typecheck && npm run check:shared && npm run mobile:typecheck && npm test",
    "eval:chat": "tsx scripts/evaluations/eval-chat.ts",
    "eval:chat:live": "tsx scripts/evaluations/eval-chat-live.ts",
    "audit:outlook": "tsx scripts/audits/audit-outlook-data.ts",
    "eval:signals": "tsx scripts/evaluations/eval-signals.ts",
    "eval:forecast": "tsx scripts/evaluations/eval-outlook-forecast.ts",
    "eval:dividends": "tsx scripts/evaluations/eval-dividend-forecast.ts",
    "backfill:index": "tsx scripts/backfills/backfill-index-history.ts",
    "check:drift": "tsx scripts/verification/check-verified-drift.ts",
    "check:freshness": "tsx scripts/verification/check-verified-freshness.ts",
    "check:registry": "npm run check:drift && npm run check:freshness",
    "check:shared": "node scripts/verification/check-shared-purity.mjs && npm run typecheck --workspace @psx/shared",
    "mobile": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:typecheck": "npm --prefix mobile run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@serwist/next": "^9.5.11",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "lucide-react": "^1.41.0",
    "next": "16.2.9",
    "openai": "^6.42.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.11",
    "tailwind-merge": "^3.6.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
