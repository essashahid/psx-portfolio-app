# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cached filing PDFs (data/filings-cache/) — large binaries, rebuildable from
# data/reference/filings-inventory.json, which records the source URL and fetch date
.cache/filings/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Claude Code settings (may contain machine-specific secrets)
.claude/settings.json

# Point-in-time data audits (generated by scripts/audits/generate-coverage-report.ts) — regenerate, don't commit
reports/

# Local repository-tree dumps (regenerate with `tree`)
tree.txt

# Next.js/Serwist build output that lands in public/
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# Real personal brokerage/CDC documents. Never commit these — point
# AKD_LEDGER_PDF_PATH at a copy outside the repository instead.
data/private/

# Per-company backfill run logs. Rebuilt by scripts/backfills/run-batch-backfill.ts
# on every run; the durable record is data/reference/backfill-progress.json.
logs/
